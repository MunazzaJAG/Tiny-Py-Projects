import turtle
from turtle import Turtle, Screen
import random

screen = Screen()
screen.setup(500,400)
choice= screen.textinput(title="Make your bet", prompt="which turtle will win the race? Enter a color: ")
colors= ['red','orange','yellow','green','blue','purple']
y_pos=[80, 50, 20, -10, -40, -70]
turtles=[]

for i in range(0,6):
    new_turtle= Turtle()
    new_turtle.shape("turtle")
    new_turtle.color(colors[i])
    new_turtle.penup()
    new_turtle.goto(-230, y_pos[i])
    turtles.append(new_turtle)

race_on= False
if choice:
    race_on= True

while race_on:
    for turtle in turtles:
        if turtle.xcor()>230:
            race_on= False
            winner= turtle.pencolor()
            if winner==choice:
                print(f"you won! The {winner} turtle wins!")
            else:
                print(f"you lost! The {winner} turtle wins!")

        turtle.forward(random.randint(0,10))

screen.exitonclick()
